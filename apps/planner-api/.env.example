# =====================================================================
# N-EYE PLANNER GATEWAY — SERVER CONFIGURATION (ENVIRONMENT VARIABLES)
# =====================================================================
# Provider credentials must stay server-side; NEVER bundle them into the Chrome extension.

# Provider options: "mock" | "gemini" | "openai"
PLANNER_PROVIDER=mock

# Google Gemini Configuration
# GEMINI_API_KEY=your_gemini_api_key_here
PLANNER_MODEL=gemini-2.5-flash

# OpenAI / OpenAI-Compatible Configuration
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Gateway Service Settings
PLANNER_HOST=0.0.0.0
PLANNER_PORT=8000
PLANNER_MAX_PAYLOAD_BYTES=262144
PLANNER_REQUEST_TIMEOUT_SECONDS=15.0

# CORS Allowed Origins (Comma-separated, e.g. chrome extension IDs and localhost)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
