{
  "version": "t030-pii-holdout/1",
  "frozen": true,
  "notes": "Frozen T030 PII holdout. Do not retune detectors against this file. Labels are desired behavior, not current-detector mirrors.",
  "samples": [
    {
      "id": "hold-email-plus",
      "split": "eval",
      "channel": "dom_label",
      "mode": "element",
      "classTag": "email",
      "innerText": "ops+holdout@lab.example.org",
      "expectedClasses": ["PII_EMAIL"],
      "rawSecrets": ["ops+holdout@lab.example.org"]
    },
    {
      "id": "hold-email-ocr",
      "split": "eval",
      "channel": "ocr",
      "mode": "ocr",
      "classTag": "ocr-pii",
